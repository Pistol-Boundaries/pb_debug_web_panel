SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_LOGS_TABLE=activity_logs
DEFAULT_LOG_LIMIT=100
APP_PASSWORD=arsenal
SESSION_SECRET=replace-this-with-a-random-secret

# Test Firebase Admin auth. Prefer a local JSON file path that is ignored by git.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
# Alternative to FIREBASE_SERVICE_ACCOUNT_FILE:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Test user defaults. Tests create unique emails under this domain.
TEST_USER_EMAIL_DOMAIN=example.test
TEST_USER_PASSWORD=ChangeMe123!
